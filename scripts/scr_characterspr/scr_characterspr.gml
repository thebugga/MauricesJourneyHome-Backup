function scr_characterspr()
{
	if (character == "M")
	{
		spr_idle = spr_maurice_idle;
		spr_move = spr_maurice_move;
		spr_jump = spr_maurice_jump;
		spr_fall = spr_maurice_fall
		spr_land = spr_maurice_land1
		spr_land2 = spr_maurice_land
		spr_lookdoor = spr_maurice_lookdoor
		spr_walkfront = spr_maurice_idle
		spr_downpizzabox = spr_maurice_idle
		spr_uppizzabox = spr_maurice_idle
		spr_walljump = spr_maurice_idle
		spr_walljumpfall = spr_maurice_idle
		spr_mach = spr_maurice_mach2
		spr_mach1 = spr_maurice_mach2
		spr_machturn = spr_maurice_machturn
		spr_mach3 = spr_maurice_mach3
		spr_mach3jump = spr_maurice_mach3jump
		spr_mach3hit = spr_maurice_mach3hit
		spr_mach3turn = spr_maurice_mach3turn
		spr_machslidestart = spr_maurice_machslidestart
		spr_machslide = spr_maurice_machslide
		spr_machjump = spr_maurice_machjump
		spr_climbwall = spr_maurice_runwall
		spr_machjumpfall = spr_maurice_machjumpfall
		spr_roll = spr_maurice_roll
		spr_dive = spr_maurice_dive
		spr_nickel1 = spr_maurice_nickel1;
		spr_nickel2 = spr_maurice_kill;
		spr_palette = spr_mauricepalette
	}
	if (character == "D")
	{
		spr_idle = spr_dragonmount_idle;
		spr_move = spr_dragonmount_idle;
		spr_jump = spr_dragonmount_idle;
		spr_fall = spr_dragonmount_idle
		spr_land = spr_dragonmount_idle
		spr_land2 = spr_dragonmount_idle
		spr_lookdoor = spr_dragonmount_idle
		spr_walkfront = spr_dragonmount_idle
		spr_downpizzabox = spr_dragonmount_idle
		spr_uppizzabox = spr_dragonmount_idle
		spr_walljump = spr_dragonmount_idle
		spr_walljumpfall = spr_dragonmount_idle
		spr_mach = spr_dragonmount_idle
		spr_mach1 = spr_dragonmount_idle
		spr_machturn = spr_dragonmount_idle
		spr_mach3 = spr_dragonmount_idle
		spr_mach3jump = spr_dragonmount_idle
		spr_mach3hit = spr_dragonmount_idle
		spr_mach3turn = spr_dragonmount_idle
		spr_machslide = spr_dragonmount_idle
		spr_machjump = spr_dragonmount_idle
		spr_climbwall = spr_dragonmount_idle
		spr_machjumpfall = spr_dragonmount_idle
		spr_roll = spr_dragonmount_idle
		spr_dive = spr_dragonmount_idle
		spr_nickel1 = spr_dragonmount_idle;
		spr_nickel2 = spr_dragonmount_idle;
	}
}