draw_set_halign(fa_center)
draw_set_valign(fa_middle)
if (fadedin)
{
	draw_clear(c_black)
	var cardshakex = irandom_range(-wipshake, wipshake)
	var cardshakey = irandom_range(-wipshake, wipshake)
	x = cardshakex
	y = cardshakey
	draw_self()
		shader_set(global.retro_pal_swapper)
		pal_swap_set(spr_peppalette, obj_player1.player_paletteselect[0], false)
		//pattern_set(global.Base_Pattern_Color, sprite_index, image_index, image_xscale, image_yscale, obj_player1.player_patterntexture[0])
		draw_sprite(spr_titlecards_maurice, image_index, cardshakex, cardshakey)
		pal_swap_set(spr_noisepalette, obj_player1.player_paletteselect[1], false)
		//pattern_set(global.Base_Pattern_Color, sprite_index, image_index, image_xscale, image_yscale, obj_player1.player_patterntexture[1])
		draw_sprite(spr_titlecards_doise, image_index, cardshakex, cardshakey)
		//pattern_reset()
		reset_shader_fix()
	draw_sprite_ext(spr_titlecard_titles, image_index, 0 + irandom_range(-1, 1) + irandom_range(-wipshake, wipshake), 0 + irandom_range(-1, 1) + irandom_range(-wipshake, wipshake), 1, 1, 0, c_white, titlealpha)
	if wipshow
		draw_sprite_ext(spr_titlecards_wip, wipindex, 480 + irandom_range(-wipshake, wipshake), 270 + irandom_range(-wipshake, wipshake), wipscale, wipscale, wipangle, c_white, titlealpha)
	draw_set_font(global.creditsfont)
	var _layouty = titlecredit[image_index][2] - (string_height(titlecredit[image_index][5]) / 2)
	var _arty = titlecredit[image_index][2] - (string_height(titlecredit[image_index][6]) / 2)
	var _musicy = titlecredit[image_index][2] - (string_height(titlecredit[image_index][7]) / 2)
	draw_text_color(titlecredit[image_index][1], titlecredit[image_index][2], titlecredit[image_index][5], c_white, c_white, c_white, c_white, layoutalpha)
	draw_text_color(titlecredit[image_index][1], titlecredit[image_index][2], titlecredit[image_index][6], c_white, c_white, c_white, c_white, artalpha)
	draw_text_color(titlecredit[image_index][1], titlecredit[image_index][2], titlecredit[image_index][7], c_white, c_white, c_white, c_white, musicalpha)
	draw_set_font(global.smallfont)
	draw_set_valign(fa_bottom)
	draw_text_color(titlecredit[image_index][1], _layouty, "STORYBOARDED BY", c_white, c_white, c_white, c_white, layoutalpha)
	draw_text_color(titlecredit[image_index][1], _arty, "BACKGROUNDS BY", c_white, c_white, c_white, c_white, artalpha)
	draw_text_color(titlecredit[image_index][1], _musicy, "COMPOSED BY", c_white, c_white, c_white, c_white, musicalpha)
	draw_set_halign(fa_right)
	draw_set_valign(fa_bottom)
	var skipy = (global.option_timer ? 510 : 530)
	draw_text_color(950, skipy, "PRESS JUMP TO SKIP", c_white, c_white, c_white, c_white, skipalpha)
}
draw_set_alpha(fadealpha)
draw_rectangle_color(0, 0, 960, 540, c_black, c_black, c_black, c_black, false)
draw_set_alpha(1)
