draw_set_font(global.bigfont)
draw_set_halign(fa_left)
draw_set_color(c_gray)
if (selected == -1)
	draw_set_color(c_white)
draw_text(150, 100, "BACK")
draw_set_color(c_gray)
if (selected == 0)
	draw_set_color(c_white)
draw_text(150, 148, concat("TIMER: ", global.option_timer ? "ON" : "OFF"))
draw_set_color(c_gray)
if (selected == 1)
	draw_set_color(c_white)
draw_text(150, 196, concat("TIMER TYPE: ", global.option_timer_type ? "FILE" : "LEVEL"))