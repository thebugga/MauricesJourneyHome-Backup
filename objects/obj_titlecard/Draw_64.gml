draw_set_halign(fa_center)
draw_set_valign(fa_middle)
if (fadedin)
{
	draw_self()
		shader_set(global.Pal_Shader)
		pal_swap_set(spr_peppalette, obj_player1.player_paletteselect[0], false)
		pattern_set(global.Base_Pattern_Color, sprite_index, image_index, image_xscale, image_yscale, obj_player1.player_patterntexture[0])
		draw_sprite(spr_titlecards_maurice, titlecardi, 0, 0)
		pattern_reset()
		reset_shader_fix()
	draw_sprite_ext(spr_titlecard_titles, titlecardi, 0 + irandom_range(-1, 1), 0 + irandom_range(-1, 1), 1, 1, 0, c_white, titlealpha)
	draw_set_font(global.creditsfont)
	var _layouty = titlecredit[1] - (string_height(titlecredit[4]) / 2)
	var _arty = titlecredit[1] - (string_height(titlecredit[5]) / 2)
	var _musicy = titlecredit[1] - (string_height(titlecredit[6]) / 2)
	draw_text_color(titlecredit[0], titlecredit[1], titlecredit[4], c_white, c_white, c_white, c_white, layoutalpha)
	draw_text_color(titlecredit[0], titlecredit[1], titlecredit[5], c_white, c_white, c_white, c_white, artalpha)
	draw_text_color(titlecredit[0], titlecredit[1], titlecredit[6], c_white, c_white, c_white, c_white, musicalpha)
	draw_set_font(global.smallfont)
	draw_set_valign(fa_bottom)
	draw_text_color(titlecredit[0], _layouty, "STORYBOARDED BY", c_white, c_white, c_white, c_white, layoutalpha)
	draw_text_color(titlecredit[0], _arty, "BACKGROUNDS BY", c_white, c_white, c_white, c_white, artalpha)
	draw_text_color(titlecredit[0], _musicy, "COMPOSED BY", c_white, c_white, c_white, c_white, musicalpha)
	draw_text_color(titlecredit[0], titlecredit[1] + 100, "!CREDITS NOT FINALIZED!", c_white, c_white, c_white, c_white, disclaimeralpha)
}
draw_set_alpha(fadealpha)
draw_rectangle_color(0, 0, 960, 540, c_black, c_black, c_black, c_black, false)
draw_set_alpha(1)
